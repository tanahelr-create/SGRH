.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Runtime uploaded files (contient des documents personnels réels, jamais versionnés)
server/uploads/
server/private-uploads/
